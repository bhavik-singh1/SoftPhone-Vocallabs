# ──────────────────────────────────────────────────────────────
#  SoftPhone-Vocallabs — environment template
#  Copy to .env and fill in real values. .env is gitignored.
# ──────────────────────────────────────────────────────────────

# ===== Public host / media =====
# For LOCAL dev this is your machine's LAN IP (NOT 127.0.0.1 — WebRTC media
# needs a routable address). On a VPS, set it to the server's public IP.
PUBLIC_IP=192.168.1.100
# The host's PRIVATE IP (cloud VPC IP). On a VPS, deploy-vps.sh auto-sets this.
# coturn binds/relays here and advertises PUBLIC_IP (external-ip=PUBLIC/PRIVATE).
PRIVATE_IP=192.168.1.100
# Domain used for TLS / WSS (mkcert locally, real domain in cloud).
PUBLIC_HOST=softphone.local

# ===== SIP trunk (PSTN provider) =====
# Two accounts may share one gateway for OPPOSITE directions — keep them
# separate. The OUTBOUND account places calls; the INBOUND account receives
# them. Using the inbound account for outbound can get calls flagged as spam.
TRUNK_HOST=20.193.182.13
TRUNK_PORT=5060

# --- OUTBOUND: dashboard → PSTN ---
TRUNK_USERNAME=your_outbound_username
TRUNK_PASSWORD=your_outbound_password
# Digits prepended to the dialed number before sending to the trunk. Providers
# differ (national "0", full international "0091" = 00+91 India, or bare). If
# outbound returns a carrier 404, capture SIP (tcpdump/sngrep) and try variants.
TRUNK_PREFIX=0
# Caller ID on outbound — MUST be a DID assigned to the account or the carrier
# returns 403 Forbidden. (Set on the channel by the dialplan.)
TRUNK_CALLER_ID=00910000000000

# --- INBOUND: PSTN → dashboard (rings the browser). Leave blank to disable. ---
INBOUND_USERNAME=your_inbound_username
INBOUND_PASSWORD=your_inbound_password
# The DID number (for reference/logging).
INBOUND_DID=910000000000

# ===== Softphone (browser) SIP account =====
# The WebRTC endpoint the browser registers as (created in Asterisk pjsip).
SOFTPHONE_USER=webrtc
SOFTPHONE_PASSWORD=change-me-webrtc-secret

# ===== Asterisk AMI (backend reads live call events) =====
AMI_HOST=asterisk
AMI_PORT=5038
AMI_USER=backend
AMI_PASSWORD=change-me-ami-secret

# ===== Backend =====
BACKEND_PORT=3000
JWT_SECRET=change-me-long-random-string
# App users seeded into the `users` table (scrypt-hashed). Comma-separated
# "user:pass" pairs. Each user gets their own call history. Re-seeded on every
# boot (existing usernames are left untouched), so add a pair here + restart to
# create a new login.
SEED_USERS=admin:admin123,joeydash:joeydash@1234,vaibhav:vaibhav@1234

# ===== Postgres =====
POSTGRES_USER=softphone
POSTGRES_PASSWORD=change-me-db-secret
POSTGRES_DB=softphone
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== TURN/STUN (coturn) =====
TURN_SECRET=change-me-turn-secret
TURN_REALM=softphone.local

# ===== External managed TURN (metered.ca) — recommended for CGNAT/mobile =====
# Off-host TURN avoids the same-host NAT hairpin. Get free creds at metered.ca.
METERED_TURN_HOST=global.relay.metered.ca
METERED_TURN_USER=
METERED_TURN_CRED=
